{
  "name": "p005-reporting-assistant",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\""
  },
  "dependencies": { "express": "^4.19.2" },
  "devDependencies": { "concurrently": "^8.2.2" }
}
